{
  "name": "warframe-prime-arbitrage-scanner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:d1:sql": "node scripts/cf-init-d1.mjs",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types",
    "db:push": "DATABASE_URL=\"${DATABASE_URL:-postgresql://wf:wf@127.0.0.1:5432/wfarb}\" prisma db push",
    "db:setup": "DATABASE_URL=\"${DATABASE_URL:-postgresql://wf:wf@127.0.0.1:5432/wfarb}\" prisma db push --skip-generate --accept-data-loss",
    "dev": "next dev -H 0.0.0.0",
    "lint": "next lint",
    "predev": "node scripts/setup-env.mjs",
    "prisma:pg": "prisma generate --schema prisma/schema.prisma",
    "setup": "node scripts/setup-env.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:render": "sh ./scripts/start-render.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.6.0",
    "@prisma/adapter-d1": "^5.22.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
